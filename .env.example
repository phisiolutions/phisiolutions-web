# Dirección pública de la web (sin barra final)
SITE_URL=https://www.phisiolutions.com

# Stripe (Dashboard > Desarrolladores > Claves de API). Usa claves sk_test_ para probar.
STRIPE_SECRET_KEY=sk_test_xxx
# Secreto del endpoint de webhook https://TU-DOMINIO/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Transferencia bancaria en EUR (true/false) y país de la cuenta virtual
ENABLE_BANK_TRANSFER=true
STRIPE_EU_BANK_COUNTRY=ES
# Pie de la factura
INVOICE_FOOTER=Phisiolutions LLC · [dirección] · [EIN]

# Base de datos (Turso / libSQL). En local basta con file:local.db
DATABASE_URL=libsql://tu-base.turso.io
DATABASE_AUTH_TOKEN=xxx

# Zoom: app "Server-to-Server OAuth" (marketplace.zoom.us)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Email (Gmail: smtp.gmail.com, puerto 465, contraseña de aplicación)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=phisiolutions@gmail.com
SMTP_PASS=contraseña-de-aplicación
MAIL_FROM=Phisiolutions <phisiolutions@gmail.com>
# Recibe la copia de cada factura
ADMIN_EMAIL=phisiolutions@gmail.com
